<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".LocalShareApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="WiShare"
        android:theme="@style/Theme.LocalShare">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:label="WiShare"
            android:theme="@style/Theme.LocalShare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings &amp; Users"
            android:theme="@style/Theme.Material3.DayNight"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".UserListActivity"
            android:exported="false"
            android:label="User Manager"
            android:theme="@style/Theme.LocalShare"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".UserDetailActivity"
            android:exported="false"
            android:label="User Details"
            android:theme="@style/Theme.LocalShare"
            android:parentActivityName=".UserListActivity" />
        <service android:name=".service.FileShareService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <receiver android:name=".notification.AccessRequestActionReceiver"
            android:exported="false" />
    </application>
</manifest>
