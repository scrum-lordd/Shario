<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LocalShare Server"
                    style="@style/TextAppearance.Material3.TitleLarge"/>
                <TextView
                    android:textColor="?attr/colorPrimary"
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Stopped"/>
                <TextView
                    android:id="@+id/tvUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="http://-"
                    android:textIsSelectable="true"
                    style="@style/TextAppearance.Material3.BodyLarge"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:textStyle="bold"
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:text="Start"
                        android:layout_weight="1"
                        app:cornerRadius="12dp"/>
                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"/>
                    <com.google.android.material.button.MaterialButton
                        android:textStyle="bold"
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:text="Stop"
                        android:layout_weight="1"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Scan QR Code to Connect"
                    style="@style/TextAppearance.Material3.TitleMedium"/>
                <ImageView
                    android:id="@+id/ivQr"
                    android:background="#f0f0f0"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="QR Code"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap QR code to enlarge"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Pending Access Requests"
                    style="@style/TextAppearance.Material3.TitleMedium"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/tvNoRequests"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No pending requests at this time."/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Folder to Share"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add File to Share"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>
</ScrollView>
