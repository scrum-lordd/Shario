<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_alignParentTop="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:text="WiShare"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvTopSubtitle"
                android:text="Fast &amp; Secure Wi-Fi File Sharing"
                android:textSize="12sp"
                android:textColor="@color/primary_purple_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Live Server Status Indicator Pill -->
        <LinearLayout
            android:id="@+id/pillServerStatus"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_pill_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_pill_red"
                android:backgroundTint="@color/status_offline"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvTopStatusBadge"
                android:text="OFFLINE"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/status_offline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame (Switching between 4 tabs) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== TAB 1: HOME ==================== -->
        <ScrollView
            android:id="@+id/tabHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Server Control Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Server Controls"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvStatus"
                            android:text="Server Stopped • Offline"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_offline"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <!-- URL Box with Copy Button -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_pill_purple"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:layout_marginTop="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvUrl"
                                android:text="http://192.168.1.100:8080/"
                                android:textColor="@color/primary_purple_neon"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textIsSelectable="true"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"/>

                            <ImageView
                                android:id="@+id/btnCopyUrl"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/primary_purple_light"
                                android:padding="4dp"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="Copy URL" />
                        </LinearLayout>

                        <!-- Start / Stop Action Buttons -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStart"
                                android:text="Start Server"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/primary_purple"
                                app:cornerRadius="12dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="50dp"/>

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStop"
                                android:text="Stop Server"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/status_offline"
                                app:cornerRadius="12dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="50dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Server Overview & Metrics (2x2 Grid) -->
                <TextView
                    android:text="Server Metrics &amp; Load"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Stat 1: Connected Devices -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/ic_devices"
                                app:tint="@color/primary_purple"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Devices" />

                            <TextView
                                android:id="@+id/tvStatDevices"
                                android:text="0"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Active Devices"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stat 2: Server Load -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/ic_cpu"
                                app:tint="@color/primary_purple_neon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Load" />

                            <TextView
                                android:id="@+id/tvStatLoad"
                                android:text="0%"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Server Load"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Stat 3: Serving Rate -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/ic_speed"
                                app:tint="@color/status_online"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Rate" />

                            <TextView
                                android:id="@+id/tvStatRate"
                                android:text="0 KB/s"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Serving Rate"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stat 4: Total Requests -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_subtle"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/ic_requests"
                                app:tint="@color/primary_purple_light"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Requests" />

                            <TextView
                                android:id="@+id/tvStatRequests"
                                android:text="0"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginTop="8dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Total Requests"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Statistical Downloads Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Downloads Per Day"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/white"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvWeeklyTotalBadge"
                                android:text="7 Days Activity"
                                android:textSize="11sp"
                                android:textColor="@color/primary_purple_neon"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:background="@drawable/bg_pill_purple"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Custom Dynamic Bar Chart -->
                        <com.localshare.ui.DailyDownloadsChartView
                            android:id="@+id/chartWeeklyDownloads"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- QR Code Box Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Scan to Connect"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_marginBottom="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/white"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/ivQr"
                                android:padding="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="QR Code"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:text="Tap QR code to enlarge"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pending Access Requests Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Pending Access Requests"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_marginBottom="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvNoRequests"
                            android:text="No pending access requests."
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:paddingVertical="12dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRequests"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>


        <!-- ==================== TAB 2: SHARED FILES ==================== -->
        <LinearLayout
            android:id="@+id/tabShared"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Breadcrumbs & Header -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBackShared"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/primary_purple"
                    android:padding="6dp"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Back" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSharedTitle"
                        android:text="Shared Folders &amp; Files"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvSharedPath"
                        android:text="Location: Root"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSharedCountBadge"
                    android:text="0 items"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_purple_neon"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_pill_purple"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Quick Add Action Buttons Bar -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSharedAddFolder"
                    android:text="+ Add Folder"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/primary_purple"
                    app:cornerRadius="12dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"/>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSharedAddFile"
                    android:text="+ Add File"
                    android:textStyle="bold"
                    android:textColor="@color/primary_purple_light"
                    app:strokeColor="@color/primary_purple"
                    app:strokeWidth="1dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"/>
            </LinearLayout>

            <!-- Empty State for Shared Tab -->
            <LinearLayout
                android:id="@+id/layoutEmptyShared"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_folder"
                    app:tint="@color/border_subtle"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Empty" />

                <TextView
                    android:text="No folders or files shared yet"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Use '+ Add Folder' or '+ Add File' above to make files accessible on your local network."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- List of Shared Resources -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSharedTab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"/>
        </LinearLayout>


        <!-- ==================== TAB 3: LOGS ==================== -->
        <LinearLayout
            android:id="@+id/tabLogs"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Logs Header Bar -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Server Logs"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Live event tracking"
                        android:textSize="12sp"
                        android:textColor="@color/status_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearLogs"
                    android:text="Clear Logs"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    style="@style/Widget.Material3.Button.TonalButton"
                    app:backgroundTint="@color/bg_card"
                    app:cornerRadius="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"/>
            </LinearLayout>

            <!-- Empty Logs Text -->
            <TextView
                android:id="@+id/tvNoLogs"
                android:text="No server logs yet. Activity will appear here in real time."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- RecyclerView of Logs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLogsTab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"/>
        </LinearLayout>


        <!-- ==================== TAB 4: SETTINGS ==================== -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Server Configuration"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- Port Settings Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Listening Port"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Default port is 8080 (range 1024 - 65535)."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilSettingsPort"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etSettingsPort"
                                    android:inputType="number"
                                    android:textColor="@color/white"
                                    android:text="8080"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSavePort"
                                android:text="Save"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/primary_purple"
                                app:cornerRadius="10dp"
                                android:layout_marginStart="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Access & User Management Card -->
                <TextView
                    android:text="Access &amp; Users"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Manage Connected Users"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="View registered accounts, approve access, or revoke permissions."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageUsers"
                            android:text="Open User Manager"
                            android:textStyle="bold"
                            android:textColor="@color/primary_purple_light"
                            app:strokeColor="@color/primary_purple"
                            app:strokeWidth="1dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            app:cornerRadius="10dp"
                            android:layout_marginTop="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Data & Maintenance Card -->
                <TextView
                    android:text="Maintenance"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearAllLogsSettings"
                            android:text="Clear All Activity Logs"
                            style="@style/Widget.Material3.Button.TonalButton"
                            app:backgroundTint="@color/bg_card_secondary"
                            android:textColor="@color/white"
                            app:cornerRadius="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetDatabase"
                            android:text="Reset Shared List &amp; Stats"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:textColor="#EF4444"
                            app:strokeColor="#EF4444"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- About Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="About WiShare"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Version 1.0.0 • WiShare Local Wi-Fi File Sharing\nFast, encrypted, direct Wi-Fi and FTP/FTPS transfers with owner approvals."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Modern Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemRippleColor="@color/purple_glow"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"/>

</RelativeLayout>
